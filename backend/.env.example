# AI 分析服务配置
# 请复制此文件为 .env 并填入您的 API 密钥

# DeepSeek API 配置 (推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 或者使用 OpenAI API (兼容格式)
# DEEPSEEK_API_KEY=your_openai_api_key_here
# AI_API_BASE_URL=https://api.openai.com
# AI_MODEL=gpt-3.5-turbo

# 注意：
# - base_url 不需要 /v1 后缀，OpenAI SDK 会自动添加
# - DEEPSEEK_API_KEY 和 OPENAI_API_KEY 都可以使用
# - 如需使用其他 OpenAI 兼容服务，修改 AI_API_BASE_URL 即可
