# 把本文件复制为 .env.local 并按需修改。
# .env.local 已 gitignore，永远不会被推到远程。

# 后端 API 地址。如果后端跑在其它主机/端口需要改这里。
NEXT_PUBLIC_API_URL=http://localhost:8000

# 摄像头默认地址。
# - 留空 → 让后端走 camera_id=0（本地 USB / 有线相机）
# - 手机 IP 摄像头示例：http://用户名:密码@IP:端口/
# 运行时还可以在「焊缝检测」页面右上角齿轮按钮里改，会覆盖此处的默认值。
NEXT_PUBLIC_CAMERA_URL=

# 应用名（前端展示用，可改）
NEXT_PUBLIC_APP_NAME=焊育智眸
